# sent_id = hin-w-media-lot18at_P2_S74
# text = इनके परस्पर संवाद द्वारा अंतर्राष्ट्र क्षितिजपर मान-वीय संस्कृतिपर पड़ रहे अभिशप्त सुर्यग्रहण तथा व्याव-सायिक शोषणके प्यासे सामूहिक हत्यारोंके साथ-साथ पतित अधोमुख, पूँजीवादी पद्धतियाँ, जनमतपर पहरा देती सामुहिक हिप्नोसिसकी अंधिका आदिकी भयावह पृष्ठभूमिमें इतिहास और मनुष्यकी नियतिको बार-बार परिरेखित कियाहै
# translit_iast = inake paraspara saṃvāda dvārā aṃtarrāṣṭra kṣitijapara māna-vīya saṃskṛtipara par̤a rahe abhiśapta suryagrahaṇa tathā vyāva-sāyika śoṣaṇake pyāse sāmūhika hatyāroṃke sātha-sātha patita adhomukha, pū~jīvādī paddhatiyā~, janamatapara paharā detī sāmuhika hipnosisakī aṃdhikā ādikī bhayāvaha pṛṣṭhabhūmimeṃ itihāsa aura manuṣyakī niyatiko bāra-bāra parirekhita kiyāhai
# translit_itrans = inake paraspara saMvAda dvArA aMtarrAShTra kShitijapara mAna-vIya saMskRRitipara pa.Da rahe abhishapta suryagrahaNa tathA vyAva-sAyika shoShaNake pyAse sAmUhika hatyAroMke sAtha-sAtha patita adhomukha, pU.NjIvAdI paddhatiyA.N, janamatapara paharA detI sAmuhika hipnosisakI aMdhikA AdikI bhayAvaha pRRiShThabhUmimeM itihAsa aura manuShyakI niyatiko bAra-bAra parirekhita kiyAhai
# translit_indicxlit = inke paraspar samvad dwara antarrashtra kshitijpar maan-veeya sanskritipar parh rahe abhishapt suryagrahan tathaa vyaav-saayik shoshanke pyaase saamoohik hatyaaronke saath-saath patit adhomukh, poonjivaadi paddhatiyan, janmatpar pahara detee saamuhik hypnosysky andhika aadiki bhayaavah prishthabhoomimen itihas aur manushyaki niyatiko baar-baar parirekhit kiahai
