# text = -- `आज मनुजकी इकहरी चेतना परिधिमें समावेश होरहा निखिलका एकांतिकी भावनाओंपर सर्व समन्वित जन संस्कृतिका इतिहासोंका अंधकार जो पिघल रहाहै नये साम्य मूल्योंका सूरज निकल रहाहै अंतमें कविके धरा-स्तव द्वारा कविकी आस्थाके प्रति आभार व्यक्त कियाजा सकताहै क्योंकि यही कवि दृष्टि मानव-स्वस्त्ययनका मूलाधार है।
# translit_iast = -- `āja manujakī ikaharī cetanā paridhimeṃ samāveśa horahā nikhilakā ekāṃtikī bhāvanāoṃpara sarva samanvita jana saṃskṛtikā itihāsoṃkā aṃdhakāra jo pighala rahāhai naye sāmya mūlyoṃkā sūraja nikala rahāhai aṃtameṃ kavike dharā-stava dvārā kavikī āsthāke prati ābhāra vyakta kiyājā sakatāhai kyoṃki yahī kavi dṛṣṭi mānava-svastyayanakā mūlādhāra hai|
# translit_itrans = -- `Aja manujakI ikaharI chetanA paridhimeM samAvesha horahA nikhilakA ekAMtikI bhAvanAoMpara sarva samanvita jana saMskRRitikA itihAsoMkA aMdhakAra jo pighala rahAhai naye sAmya mUlyoMkA sUraja nikala rahAhai aMtameM kavike dharA-stava dvArA kavikI AsthAke prati AbhAra vyakta kiyAjA sakatAhai kyoMki yahI kavi dRRiShTi mAnava-svastyayanakA mUlAdhAra hai|
# translit_indicxlit = -- `aaj manujaki ikahari chetna paridhimein samavesh horaha nikhilka ekantiki bhavanaonpar serve samanvit jana sanskritika itihasonka andhkaar zoo pighal rahaahai naye saamya moolyonka suraj nickel rahaahai antamen kavike dhara-stav dwara kaviki aasthaake prati aabhar vyakt kiaza saktaahai kyonki yahee kavi drishti maanav-swastyayanka muladhar hai.
